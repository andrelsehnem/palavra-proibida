# json | firebase
EXPO_PUBLIC_WORD_SOURCE=json

# Android only (production unit). In dev, the app always uses Google TestIds.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-7478664676745892/7217948330

# Set false only if you need to disable ads temporarily.
EXPO_PUBLIC_ADS_ENABLED=true

# Sentry DSN for runtime error monitoring (Android/iOS/Web).
EXPO_PUBLIC_SENTRY_DSN=

# Optional environment label sent to Sentry events.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development

# Sentry auth token used only during native/web build sourcemap upload.
# Do not commit real tokens. Prefer .env.local or CI/EAS secrets.
SENTRY_AUTH_TOKEN=
